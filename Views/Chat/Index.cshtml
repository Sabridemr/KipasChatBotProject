    <div class="chat-container" id="chatContainer">
        <div id="endChatModal" class="modal" style="display:none">
            <div class="modal-content">
                <h3>Konuşmayı Sonlandır</h3>
                <p>Konuşmanızı sonlandırmak istediğinize emin misiniz?</p>
                <div class="modal-buttons">
                    <button id="cancelEndChat">Hayır</button>
                    <button id="confirmEndChat">Evet</button>
                </div>
            </div>
        </div>

