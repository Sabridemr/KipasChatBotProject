            <div class="header-Icons" style="display:flex">
                <i id="minimizeWindows" class="window-minimize">–</i>
                <span id="maximizeScreen" onclick="toggleFullscreen()" class="maximize-btn">▢</span>
                <span id="chatboxClose" class="close-btn">⏻</span>
            </div>
        </div>



        <div class="chat-messages" id="chatMessages">
            <div class="messages-bubble bot-messages" style="padding-bottom:15px">
                Merhaba! Ben Kipaş asistanı.
            </div>
            <div class="messages-bubble bot-messages" style="padding-bottom:15px">
                Lütfen yapmak istediğiniz işlemi seçiniz.
            </div>
        </div>
        

        <div class="typing-indicator" id="typingIndicator">
            <div class="typing-dots">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>


        <div class="start-newChat">
            <button id="startNewChatBtn" style="display:none;">Yeni Sohbet Başlat</button>
        </div>



        <div class="chat-input" id="chatInputContainer">
            <input type="text" size="25" id="chatInput" placeholder="Mesajınızı yazınız." />
            <div class="send-btn" id="sendBtn">
                <svg version="1.0" xmlns="http://www.w3.org/2000/svg"
                     width="20.000000pt" height="20.000000pt" viewBox="0 0 200.000000 200.000000"
