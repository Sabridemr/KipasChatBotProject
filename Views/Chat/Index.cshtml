    </div>


    <script>
        const openBtn = document.getElementById("opnBtn");
        const container = document.getElementById("chatContainer");
        const typingIndicator = document.getElementById('typingIndicator');
        const sendBtn = document.getElementById("sendBtn");

        let sessionId;

        if (!sessionId) {
            sessionId = 'session_' + Date.now(); // örnek: session_1724761293123
            sessionStorage.setItem("sessionId", sessionId);
        }

     
        window.onload = function () {
            sessionStorage.clear(); 
            sessionId = 'session_' + Date.now(); 
            sessionStorage.setItem("sessionId", sessionId);
            
            // Buraya buton seçeneklerini giriyoruz
            const options = ["Sipariş İşlemleri"];
            showOptionButtons(options);
        };



        document.getElementById('minimizeWindows').onclick = function () {
            container.classList.remove("show"); // varsa temizle
            container.classList.add("hide");

            // Animasyon bittiğinde gizle ve sınıfı kaldır
            container.addEventListener('animationend', () => {
                container.style.display = "none";
                container.classList.remove("hide");
            }, { once: true });

            openBtn.style.display = "flex";
        };


        function toggleFullscreen() {
            container.classList.toggle('fullscreen');

        }

        


        document.querySelectorAll('.btnChoose').forEach(button => {
            button.addEventListener('click', function () {
                // Butonun üzerindeki yazıyı al
                const selected = this.textContent;

                // Seçimi mesaj olarak göster
                addMessage(selected, true);


                // Opsiyonel: Otomatik fokusla
                document.getElementById('chatInputContainer').focus();


                // Opsiyonel: Chat'e seçim bilgisini gönder
                fetch('/Chat/GetChatResponse', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ message: selected, sessionId: sessionId })

                })
                    .then(response => response.json())
                    .then(data => {
                        hideTypingIndicator();
                        addMessage(data.reply);
                    })
                    .catch(error => {
                        hideTypingIndicator();
                        addMessage("Bir hata oluştu.");
                    });
            });
        });


        document.getElementById("chatboxClose").onclick = function () {
            document.getElementById('endChatModal').style.display = 'flex';
        };

        document.getElementById('cancelEndChat').onclick = function () {
            document.getElementById('endChatModal').style.display = 'none';
        };

        document.getElementById('confirmEndChat').onclick = function () {
            // Sohbeti sıfırla
            document.getElementById('endChatModal').style.display = 'none';

            document.getElementById('chatboxClose').style.display = 'none';

            sessionStorage.clear();
            sessionId = 'session_' + Date.now();
            sessionStorage.setItem("sessionId", sessionId);

            // Input alanlarını gizle
            document.getElementById('chatInputContainer').style.display = 'none';

            document.getElementById('startNewChatBtn').style.display = 'flex';

        };


        document.getElementById('startNewChatBtn').onclick = function () {
            document.getElementById('chatMessages').innerHTML = "";
            document.getElementById('chatboxClose').style.display = 'flex';
            document.getElementById('startNewChatBtn').style.display = 'none';
            window.onload = function () {
                sessionStorage.clear();
            }

            document.getElementById('chatInputContainer').style.display = 'flex';




            addMessage("Merhaba! Ben Kipaş asistanı. ");
            addMessage("Lütfen yapmak istediğiniz işlemi seçiniz.");
            const options = ["Sipariş İşlemleri"];
            showOptionButtons(options);

            fetch('/Chat/ResetChatSession', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(response => response.json())
                .then(data => {
                    hideTypingIndicator();
                    addMessage(data.reply);
                    if (data.options) {
                        showOptionButtons(data.options);
                    }
                })

                .catch(error => {
                    console.error('Hata oluştu:', error);
                });
        };

        openBtn.addEventListener("click", () => {
            chatContainer.style.display = "flex";
            chatContainer.classList.add("show");
            openBtn.style.display = "none";

            setTimeout(() => {
                chatContainer.classList.remove("show");
            }, 400);
        },);



        function addMessage(message, isUser = false) {

            const messageContainer = document.createElement('div');
            messageContainer.style.display = 'flex';
            messageContainer.style.flexDirection = 'column';
            messageContainer.style.alignItems = isUser ? 'flex-end' : 'flex-start';
            messageContainer.style.marginBottom = '8px';


            const messageDiv = document.createElement('div');
            messageDiv.className = `messages-bubble ${isUser ? 'user-message' : 'bot-messages'}`;
            messageDiv.style.position = "relative";

            const messageText = document.createElement('div');
            messageText.textContent = message;

            const timeSpan = document.createElement('span');
            timeSpan.className = "message-time";
            const now = new Date();
            const timeText = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
            timeSpan.textContent = timeText;


            messageDiv.appendChild(messageText);
            messageDiv.appendChild(timeSpan);

            messageContainer.appendChild(messageDiv);
            chatMessages.appendChild(messageContainer);


            chatMessages.scrollTop = chatMessages.scrollHeight;
        }




        function showOptionButtons(options, showMessage) {
           if(showMessage){
                setTimeout(() => {
                    const textMessage = document.createElement('div');
                    textMessage.className = 'messages-bubble bot-messages';
                    textMessage.textContent = "Başka bir işlem yapmak ister misiniz?";
                    chatMessages.appendChild(textMessage);

                }, 500);
            }
            setTimeout(() => {
                hideTypingIndicator();
                const messageContainer = document.createElement('div');
                messageContainer.className = 'option-button-contanier';
                options.forEach(option => {
                    const btn = document.createElement('button');
                    btn.className = 'btnChoose';
                    btn.textContent = option;

                    

                    btn.onclick = function () {
                        addMessage(option, true);
                        hideOptionButtons();
                        fetch('/Chat/GetChatResponse', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ message: option, sessionId: sessionId })

                        })
                            .then(response => response.json())
                            .then(data => {
                                hideTypingIndicator();
                                addMessage(data.reply);
                                if (data.hideInput) {
                                    document.getElementById("chatInputContainer").style.display = "none";
                                    document.getElementById("startNewChatBtn").style.display = "flex";
                                } else {
                                    document.getElementById("chatInputContainer").style.display = "flex";
                                    document.getElementById("startNewChatBtn").style.display = "none";
                                }
                                if (data.options) {
                                    showOptionButtons(data.options ,data.showMessage);
                                }
                            })
                            .catch(error => {
                                hideTypingIndicator();
                                addMessage("Bir hata oluştu.");
                            });
                    };
                    messageContainer.appendChild(btn);
                });

                chatMessages.appendChild(messageContainer);
                chatMessages.scrollTop = chatMessages.scrollHeight;

            }, 1000);
        }

        function hideOptionButtons() {
            document.querySelectorAll('.btnChoose').forEach(btn => btn.remove());
        }






        function showTypingIndicator() {
            typingIndicator.style.display = 'block';
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function hideTypingIndicator() {
            typingIndicator.style.display = 'none';
        }

        function sendMessage() {
            const message = chatInput.value.trim();
            if (message === '') return;

            // Kullanıcı mesajını ekle
            addMessage(message, true);
            chatInput.value = '';
           
            // Typing indicator göster
            showTypingIndicator();

            fetch('/Chat/GetChatResponse', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ message: message, sessionId: sessionId})


            })
                .then(response => response.json())
                .then(data => {
                    // Cevap geldiğinde göster
                    hideTypingIndicator();
                    addMessage(data.reply);
                    if (data.hideInput) {
                        document.getElementById("chatInputContainer").style.display = "none";
                        document.getElementById("startNewChatBtn").style.display = "flex";
                    } else {
                        document.getElementById("chatInputContainer").style.display = "flex";
                        document.getElementById("startNewChatBtn").style.display = "none";
                    }
                    if (data.options) {
                        showOptionButtons(data.options, data.showMessage);
                    }
                })
                .catch(error => {
                    // Hata durumunda
                    hideTypingIndicator();
                    addMessage("Üzgünüm, bir hata oluştu.");
                    console.error(error);
                });
        }





        sendBtn.addEventListener('click', sendMessage);

        chatInput.addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });


        // Input focus
        chatInput.focus();
    </script>
</body>







